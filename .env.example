# Copy to .env. The app reads this file from the working directory.
# .env is gitignored. Do not put real keys in the repo.

# mock  — scripted tool-calling model, no key (default)
# openai — any OpenAI-compatible /chat/completions server
HANDA_LLM_PROVIDER=mock

# Ollama example (the model must support tool calls):
# HANDA_LLM_PROVIDER=openai
# HANDA_LLM_BASE_URL=http://127.0.0.1:11434/v1
# HANDA_LLM_API_KEY=ollama
# HANDA_LLM_MODEL=llama3.1
HANDA_LLM_BASE_URL=https://api.openai.com/v1
HANDA_LLM_API_KEY=
HANDA_LLM_MODEL=gpt-4o-mini
HANDA_LLM_TIMEOUT_S=40

# hash — local feature-hashing vectors, no download (default)
# The vector store is still Chroma. Swap the embedder without changing the index API.
HANDA_EMBEDDINGS=hash

# Where Chroma persists the kitchen-binder index. Rebuilt from sample docs on startup.
HANDA_DATA_DIR=.handa

# Server. Hosting platforms that set PORT win over HANDA_PORT.
HANDA_HOST=0.0.0.0
HANDA_PORT=43123
HANDA_LOG_LEVEL=INFO

# How many automatic cost-down passes run before a person has to decide.
HANDA_MAX_REVISIONS=2
